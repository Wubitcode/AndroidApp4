<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true">

    <!--
        Toolbar for the My Subscriptions screen.
        Includes back navigation to the main search screen.
    -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/subscriptionsToolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorPrimary"
        app:titleTextColor="@android:color/white" />

    <!--
        Displays a message when the user has not
        subscribed to any podcasts yet.
    -->
    <TextView
        android:id="@+id/tvEmptySubscriptions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp"
        android:text="You have not subscribed to any podcasts yet."
        android:textAlignment="center"
        android:textSize="16sp"
        android:visibility="gone" />

    <!--
        Displays all podcasts saved through the
        Subscribe button on the podcast details screen.
    -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewSubscriptions"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="8dp"
        android:clipToPadding="false" />

</LinearLayout>