<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    tools:context=".MainActivity">

    <!-- Main heading for the SuperPodcast search screen. -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="SuperPodcast"
        android:textSize="28sp"
        android:textStyle="bold" />

    <!-- Allows the user to enter a podcast search term. -->
    <EditText
        android:id="@+id/etSearch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Search podcasts"
        android:inputType="text"
        android:padding="12dp" />

    <!--
        Advanced search option.
        Only podcasts whose titles contain at least this
        number of words will be displayed.
    -->
    <EditText
        android:id="@+id/etMinimumWords"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:hint="Minimum words in podcast title (optional)"
        android:inputType="number"
        android:padding="12dp" />

    <!-- Starts the podcast search request. -->
    <Button
        android:id="@+id/btnSearch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Search" />

    <!-- Displays search progress while networking is active. -->
    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="16dp"
        android:visibility="gone" />

    <!-- Displays result counts, filtering information, or errors. -->
    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text=""
        android:textSize="16sp" />

    <!-- Displays podcast search results. -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewPodcasts"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1"
        tools:listitem="@layout/item_podcast" />

</LinearLayout>